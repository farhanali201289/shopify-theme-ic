<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {% style %}
      :root {
        --cream: {{ settings.color_cream }};
        --sand: {{ settings.color_sand }};
        --accent: {{ settings.color_accent }};
        --accent-dark: {{ settings.color_accent_dark }};
        --brown: {{ settings.color_brown }};
        --taupe: {{ settings.color_taupe }};
        --gift: {{ settings.color_gift }};
        --highlight: {{ settings.color_highlight }};
        --button-bg: {{ settings.color_button_bg }};
        --button-text: {{ settings.color_button_text }};
        --page-width: {{ settings.page_width }}px;
        --card-radius: {{ settings.card_corner_radius }}px;
        --button-radius: {{ settings.button_corner_radius }}px;
        --section-spacing: {{ settings.spacing_sections }}px;
        --font-body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.IC = {
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart_add: {{ routes.cart_add_url | json }},
          cart_change: {{ routes.cart_change_url | json }},
          cart: {{ routes.cart_url | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Cart drawer (loaded once globally) {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' -%}
      <div class="cart-overlay" data-cart-overlay></div>
      <aside class="cart-drawer" data-cart-drawer aria-label="Cart" aria-modal="true" role="dialog">
        {% render 'cart-drawer' %}
      </aside>
    {%- endif -%}
  </body>
</html>
