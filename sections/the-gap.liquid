<section class="gap-grid" id="gap-{{ section.id }}">
  <div class="gap-quote">
    <div class="gap-quote__text">
      {%- if section.settings.quote != blank -%}
        <div class="gap-quote__pull">
          <p>{{ section.settings.quote }}</p>
          {%- if section.settings.attribution != blank -%}
            <p style="font-family:var(--font-body); font-size:11px; color:rgba(255,255,255,.45); letter-spacing:.08em; text-transform:uppercase;">{{ section.settings.attribution }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rte" style="font-family:var(--font-body); font-size:15px; color:rgba(255,255,255,.8); line-height:1.85;">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="gap-quote__media">{{ section.settings.image | image_url: width: 520 | image_tag: loading: 'lazy', alt: '' }}</div>
    {%- endif -%}
  </div>

  <div class="gap-stats">
    {%- for block in section.blocks -%}
      <div class="gap-stat" {{ block.shopify_attributes }}>
        {%- if block.settings.counter_end != blank and block.settings.counter_end != '0' -%}
          <div class="gap-stat__num" data-gap-counter="{{ block.settings.counter_end }}" data-prefix="{{ block.settings.counter_prefix }}" data-suffix="{{ block.settings.counter_suffix }}">
            {{ block.settings.counter_prefix }}0{{ block.settings.counter_suffix }}
          </div>
        {%- else -%}
          <div class="gap-stat__num">{{ block.settings.number }}</div>
        {%- endif -%}
        <div class="gap-stat__head">{{ block.settings.head }}</div>
        <div class="gap-stat__body">{{ block.settings.body }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  {% render 'section-spacing', sid: section.id, s: section.settings %}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gap-stats {
      grid-template-columns: {% if section.settings.stats_cols_mob == '2' %}1fr 1fr{% else %}1fr{% endif %};
    }
  }
</style>

<script>
(function(){
  var done = false;
  var els = document.querySelectorAll('#gap-{{ section.id }} [data-gap-counter]');
  if (!els.length) return;
  function run(){
    if (done) return;
    done = true;
    els.forEach(function(el){
      var end = parseInt(el.getAttribute('data-gap-counter'), 10) || 0;
      var pre = el.getAttribute('data-prefix') || '';
      var suf = el.getAttribute('data-suffix') || '';
      var t0 = null;
      function tick(ts){
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / 1000, 1);
        var e = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.floor(e * end).toLocaleString() + suf;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = pre + end.toLocaleString() + suf;
      }
      requestAnimationFrame(tick);
    });
  }
  if ('IntersectionObserver' in window) {
    var ob = new IntersectionObserver(function(entries){
      if (entries[0].isIntersecting) { run(); ob.disconnect(); }
    }, {threshold: 0.3});
    ob.observe(document.getElementById('gap-{{ section.id }}'));
  } else { run(); }
})();
</script>

{% schema %}
{
  "name": "The gap (quote + stats)",
  "settings": [
    { "type": "inline_richtext", "id": "quote", "label": "Pull quote", "default": ""The doctors are extraordinary. But nobody thinks about the rest of you."" },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— A recovery nurse we work with" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "stats_cols_mob", "label": "Stats columns (mobile)",
      "options": [{"value":"1","label":"1 column"},{"value":"2","label":"2 columns"}],
      "default": "1"
    },
    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_bottom_unit", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" },
    { "type": "header", "content": "Padding — Mobile" },
    { "type": "range", "id": "padding_top_mob", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_top_unit_mob", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom_mob", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_bottom_unit_mob", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width_mob", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit_mob", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Display value (if no counter)", "default": "73%" },
        { "type": "text", "id": "head", "label": "Headline", "default": "of patients" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "said nobody gave them guidance on what to wear before treatment." },
        { "type": "header", "content": "Counter" },
        { "type": "text", "id": "counter_end", "label": "Counter target number (empty = off)", "info": "e.g. 73" },
        { "type": "text", "id": "counter_prefix", "label": "Prefix", "info": "Text before number" },
        { "type": "text", "id": "counter_suffix", "label": "Suffix", "info": "Text after number e.g. % or +" }
      ]
    }
  ],
  "presets": [
    {
      "name": "The gap (quote + stats)",
      "blocks": [
        { "type": "stat", "settings": { "number": "73%", "counter_end": "73", "counter_suffix": "%", "head": "of patients", "body": "said nobody gave them guidance on what to wear before their first treatment appointment." } },
        { "type": "stat", "settings": { "number": "62%", "counter_end": "62", "counter_suffix": "%", "head": "cite clothing", "body": "as a significant factor in how they feel emotionally on treatment days." } },
        { "type": "stat", "settings": { "number": "89%", "counter_end": "89", "counter_suffix": "%", "head": "of our customers", "body": "felt more confident at their next appointment after receiving their kit." } },
        { "type": "stat", "settings": { "number": "1 in 4", "head": "patients told us", "body": "they wore the same clothes to every appointment because figuring it out was too hard." } }
      ]
    }
  ]
}
{% endschema %}
