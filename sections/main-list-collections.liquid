<section class="section">
  <div class="page-width">
    <h1 class="section-heading" style="text-align:center; margin-bottom:28px;">{{ section.settings.heading | default: 'Shop by condition' }}</h1>
    <div class="product-grid grid-3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="product-card">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div class="product-card__body">
            <h3 class="product-card__title">{{ collection.title }}</h3>
            {%- if collection.description != blank -%}<p class="product-card__desc">{{ collection.description | strip_html | truncatewords: 14 }}</p>{%- endif -%}
            <span class="link-underline" style="margin-top:auto;">Shop collection →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by condition" } ] }
{% endschema %}
