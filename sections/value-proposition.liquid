{%- liquid
  assign img_pos = section.settings.image_position
  assign reverse = false
  if img_pos == 'left'
    assign reverse = true
  endif
  assign img_alt = section.settings.heading | strip_html | default: 'Value proposition'
-%}

<section class="section value-section">
  <div class="page-width">
    <div class="value-intro {% if reverse %}value-intro--reverse{% endif %}">
      <div class="value-intro__content">
        {%- if section.settings.eyebrow != blank -%}<span class="vp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="vp-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="vp-text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="value-intro__media">
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: img_alt }}
        </div>
      {%- endif -%}
    </div>

    <div class="value-grid">
      {%- for block in section.blocks -%}
        <div class="value-cell" {{ block.shopify_attributes }}>
          <div class="value-cell__icon">{% render 'icon', name: block.settings.icon %}</div>
          <div class="value-cell__title">{{ block.settings.title }}</div>
          <div class="value-cell__sub">{{ block.settings.subtitle }}</div>
          <div class="value-cell__body">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- liquid
  assign eb_lh = section.settings.eb_lh | times: 1.0 | divided_by: 10.0
  assign eb_ls = section.settings.eb_ls | times: 1.0 | divided_by: 100.0
  assign eb_lh_m = section.settings.eb_lh_m | times: 1.0 | divided_by: 10.0
  assign eb_ls_m = section.settings.eb_ls_m | times: 1.0 | divided_by: 100.0

  assign h_lh = section.settings.h_lh | times: 1.0 | divided_by: 10.0
  assign h_ls = section.settings.h_ls | times: 1.0 | divided_by: 100.0
  assign h_lh_m = section.settings.h_lh_m | times: 1.0 | divided_by: 10.0
  assign h_ls_m = section.settings.h_ls_m | times: 1.0 | divided_by: 100.0

  assign t_lh = section.settings.t_lh | times: 1.0 | divided_by: 10.0
  assign t_ls = section.settings.t_ls | times: 1.0 | divided_by: 100.0
  assign t_lh_m = section.settings.t_lh_m | times: 1.0 | divided_by: 10.0
  assign t_ls_m = section.settings.t_ls_m | times: 1.0 | divided_by: 100.0

  assign vt_lh = section.settings.vt_lh | times: 1.0 | divided_by: 10.0
  assign vt_ls = section.settings.vt_ls | times: 1.0 | divided_by: 100.0
  assign vt_lh_m = section.settings.vt_lh_m | times: 1.0 | divided_by: 10.0
  assign vt_ls_m = section.settings.vt_ls_m | times: 1.0 | divided_by: 100.0

  assign vs_lh = section.settings.vs_lh | times: 1.0 | divided_by: 10.0
  assign vs_ls = section.settings.vs_ls | times: 1.0 | divided_by: 100.0
  assign vs_lh_m = section.settings.vs_lh_m | times: 1.0 | divided_by: 10.0
  assign vs_ls_m = section.settings.vs_ls_m | times: 1.0 | divided_by: 100.0

  assign vb_lh = section.settings.vb_lh | times: 1.0 | divided_by: 10.0
  assign vb_ls = section.settings.vb_ls | times: 1.0 | divided_by: 100.0
  assign vb_lh_m = section.settings.vb_lh_m | times: 1.0 | divided_by: 10.0
  assign vb_ls_m = section.settings.vb_ls_m | times: 1.0 | divided_by: 100.0
-%}

<style>
  {%- capture s -%}#shopify-section-{{ section.id }}{%- endcapture -%}

  {{ s }} .value-intro--reverse { direction: rtl; }
  {{ s }} .value-intro--reverse > * { direction: ltr; }

  {{ s }} .vp-eyebrow {
    display: block; text-transform: uppercase; margin-bottom: 8px;
    color: {{ section.settings.eb_color | default: 'inherit' }};
    font-size: {{ section.settings.eb_size }}px;
    font-weight: {{ section.settings.eb_weight }};
    text-align: {{ section.settings.eb_align }};
    line-height: {{ eb_lh }};
    letter-spacing: {{ eb_ls }}em;
  }
  {{ s }} .vp-heading {
    color: {{ section.settings.h_color | default: 'inherit' }};
    font-size: {{ section.settings.h_size }}px;
    font-weight: {{ section.settings.h_weight }};
    text-align: {{ section.settings.h_align }};
    line-height: {{ h_lh }};
    letter-spacing: {{ h_ls }}em;
  }
  {{ s }} .vp-text {
    margin-top: 16px;
    color: {{ section.settings.t_color | default: 'inherit' }};
    font-size: {{ section.settings.t_size }}px;
    font-weight: {{ section.settings.t_weight }};
    text-align: {{ section.settings.t_align }};
    line-height: {{ t_lh }};
    letter-spacing: {{ t_ls }}em;
  }
  {{ s }} .value-cell__title {
    color: {{ section.settings.vt_color | default: 'var(--accent)' }};
    font-size: {{ section.settings.vt_size }}px;
    font-weight: {{ section.settings.vt_weight }};
    text-align: {{ section.settings.vt_align }};
    line-height: {{ vt_lh }};
    letter-spacing: {{ vt_ls }}em;
  }
  {{ s }} .value-cell__sub {
    color: {{ section.settings.vs_color | default: 'var(--brown)' }};
    font-size: {{ section.settings.vs_size }}px;
    font-weight: {{ section.settings.vs_weight }};
    text-align: {{ section.settings.vs_align }};
    line-height: {{ vs_lh }};
    letter-spacing: {{ vs_ls }}em;
  }
  {{ s }} .value-cell__body {
    color: {{ section.settings.vb_color | default: 'var(--taupe)' }};
    font-size: {{ section.settings.vb_size }}px;
    font-weight: {{ section.settings.vb_weight }};
    text-align: {{ section.settings.vb_align }};
    line-height: {{ vb_lh }};
    letter-spacing: {{ vb_ls }}em;
  }

  @media (max-width: 749px) {
    {{ s }} .value-intro { grid-template-columns: 1fr; }
    {{ s }} .value-intro--reverse { direction: ltr; }
    {{ s }} .value-intro__media { order: -1; }

    {{ s }} .vp-eyebrow {
      font-size: {{ section.settings.eb_size_m }}px;
      font-weight: {{ section.settings.eb_weight_m }};
      text-align: {{ section.settings.eb_align_m }};
      line-height: {{ eb_lh_m }};
      letter-spacing: {{ eb_ls_m }}em;
    }
    {{ s }} .vp-heading {
      font-size: {{ section.settings.h_size_m }}px;
      font-weight: {{ section.settings.h_weight_m }};
      text-align: {{ section.settings.h_align_m }};
      line-height: {{ h_lh_m }};
      letter-spacing: {{ h_ls_m }}em;
    }
    {{ s }} .vp-text {
      font-size: {{ section.settings.t_size_m }}px;
      font-weight: {{ section.settings.t_weight_m }};
      text-align: {{ section.settings.t_align_m }};
      line-height: {{ t_lh_m }};
      letter-spacing: {{ t_ls_m }}em;
    }
    {{ s }} .value-cell__title {
      font-size: {{ section.settings.vt_size_m }}px;
      font-weight: {{ section.settings.vt_weight_m }};
      text-align: {{ section.settings.vt_align_m }};
      line-height: {{ vt_lh_m }};
      letter-spacing: {{ vt_ls_m }}em;
    }
    {{ s }} .value-cell__sub {
      font-size: {{ section.settings.vs_size_m }}px;
      font-weight: {{ section.settings.vs_weight_m }};
      text-align: {{ section.settings.vs_align_m }};
      line-height: {{ vs_lh_m }};
      letter-spacing: {{ vs_ls_m }}em;
    }
    {{ s }} .value-cell__body {
      font-size: {{ section.settings.vb_size_m }}px;
      font-weight: {{ section.settings.vb_weight_m }};
      text-align: {{ section.settings.vb_align_m }};
      line-height: {{ vb_lh_m }};
      letter-spacing: {{ vb_ls_m }}em;
    }
  }
  {% render 'section-spacing', sid: section.id, s: section.settings %}
</style>

