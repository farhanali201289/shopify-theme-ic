<section class="trust-strip" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color | default: '#F5F0E8' }};">
  <div class="trust-strip__inner">
    {%- for block in section.blocks -%}
      {%- if forloop.index > 1 -%}<span class="trust-stat__divider">|</span>{%- endif -%}
      <div class="trust-stat" {{ block.shopify_attributes }}>
        <span class="trust-stat__val"
          {%- if block.settings.counter_end != blank and block.settings.counter_end != '0' %} data-counter="{{ block.settings.counter_end }}" data-prefix="{{ block.settings.counter_prefix }}" data-suffix="{{ block.settings.counter_suffix }}"{% endif -%}
        >
          {{ block.settings.counter_prefix }}{% if block.settings.counter_end != blank and block.settings.counter_end != '0' %}0{% else %}0{% endif %}{{ block.settings.counter_suffix }}
        </span>
        <span class="trust-stat__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .trust-stat__val { color: {{ section.settings.value_color | default: '#F5F0E8' }}; }
  #shopify-section-{{ section.id }} .trust-stat__label { color: {{ section.settings.label_color | default: '#8a8070' }}; }
  #shopify-section-{{ section.id }} .trust-stat__divider { color: {{ section.settings.label_color | default: '#8a8070' }}; }
</style>

<script>
(function(){
  var done = false;
  var els = document.querySelectorAll('#shopify-section-{{ section.id }} [data-counter]');
  if (!els.length) return;
  function run(){
    if (done) return;
    done = true;
    els.forEach(function(el){
      var end = parseInt(el.getAttribute('data-counter'), 10) || 0;
      var pre = el.getAttribute('data-prefix') || '';
      var suf = el.getAttribute('data-suffix') || '';
      var dur = 1000;
      var t0 = null;
      function tick(ts){
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / dur, 1);
        var e = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.floor(e * end).toLocaleString() + suf;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = pre + end.toLocaleString() + suf;
      }
      requestAnimationFrame(tick);
    });
  }
  if ('IntersectionObserver' in window) {
    var ob = new IntersectionObserver(function(entries){
      if (entries[0].isIntersecting) { run(); ob.disconnect(); }
    }, {threshold: 0.3});
    ob.observe(document.querySelector('#shopify-section-{{ section.id }} .trust-strip'));
  } else { run(); }
})();
</script>

<style>{% render 'section-spacing', sid: section.id, s: section.settings %}</style>

{% schema %}
{
  "name": "Trust bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background color", "default": "#1D1A14" },
    { "type": "color", "id": "value_color", "label": "Value text color" },
    { "type": "color", "id": "label_color", "label": "Label text color" },
    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_bottom_unit", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" },
    { "type": "header", "content": "Padding — Mobile" },
    { "type": "range", "id": "padding_top_mob", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_top_unit_mob", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom_mob", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_bottom_unit_mob", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width_mob", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit_mob", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "patients served" },
        { "type": "header", "content": "Counter" },
        { "type": "text", "id": "counter_end", "label": "Counter target number (empty = off)", "info": "e.g. 14000" },
        { "type": "text", "id": "counter_prefix", "label": "Prefix", "info": "Text before number" },
        { "type": "text", "id": "counter_suffix", "label": "Suffix", "info": "Text after number e.g. + or %" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "stat", "settings": { "counter_end": "14000", "counter_suffix": "+", "label": "patients served" } },
        { "type": "stat", "settings": { "counter_end": "49", "counter_prefix": "", "counter_suffix": " ★", "label": "1,200+ reviews" } },
        { "type": "stat", "settings": { "counter_end": "1247", "label": "kits sponsored" } },
        { "type": "stat", "settings": { "counter_end": "1", "counter_prefix": "<", "counter_suffix": "%", "label": "return rate" } }
      ]
    }
  ]
}
{% endschema %}
