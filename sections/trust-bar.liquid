<section class="trust-strip" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color | default: '#F5F0E8' }};">
  <div class="trust-strip__inner">
    {%- for block in section.blocks -%}
      {%- if forloop.index > 1 -%}<span class="trust-stat__divider">|</span>{%- endif -%}
      <div class="trust-stat" {{ block.shopify_attributes }}>
        {%- if block.settings.counter_end != blank and block.settings.counter_end != '0' and block.settings.counter_end != '' -%}
          <span class="trust-stat__val" data-counter="{{ block.settings.counter_end }}" data-prefix="{{ block.settings.counter_prefix }}" data-suffix="{{ block.settings.counter_suffix }}">
            {{ block.settings.counter_prefix }}0{{ block.settings.counter_suffix }}
          </span>
        {%- else -%}
          <span class="trust-stat__val">{{ block.settings.value }}</span>
        {%- endif -%}
        <span class="trust-stat__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .trust-stat__val { color: {{ section.settings.value_color | default: '#F5F0E8' }}; }
  #shopify-section-{{ section.id }} .trust-stat__label { color: {{ section.settings.label_color | default: '#8a8070' }}; }
  #shopify-section-{{ section.id }} .trust-stat__divider { color: {{ section.settings.label_color | default: '#8a8070' }}; }
</style>

<script>
(function(){
  var done = false;
  var els = document.querySelectorAll('#shopify-section-{{ section.id }} [data-counter]');
  if (!els.length) return;
  function run(){
    if (done) return;
    done = true;
    els.forEach(function(el){
      var end = parseInt(el.getAttribute('data-counter'), 10) || 0;
      var pre = el.getAttribute('data-prefix') || '';
      var suf = el.getAttribute('data-suffix') || '';
      var dur = 1000;
      var t0 = null;
      function tick(ts){
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / dur, 1);
        var e = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.floor(e * end).toLocaleString() + suf;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = pre + end.toLocaleString() + suf;
      }
      requestAnimationFrame(tick);
    });
  }
  if ('IntersectionObserver' in window) {
    var ob = new IntersectionObserver(function(entries){
      if (entries[0].isIntersecting) { run(); ob.disconnect(); }
    }, {threshold: 0.3});
    ob.observe(document.querySelector('#shopify-section-{{ section.id }} .trust-strip'));
  } else { run(); }
})();
</script>

{% schema %}
{
  "name": "Trust bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background color", "default": "#1D1A14" },
    { "type": "color", "id": "value_color", "label": "Value text color" },
    { "type": "color", "id": "label_color", "label": "Label text color" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Static value (used if counter is empty)", "default": "14k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "patients served" },
        { "type": "header", "content": "Counter" },
        { "type": "text", "id": "counter_end", "label": "Counter target number (empty = off)", "info": "e.g. 14000" },
        { "type": "text", "id": "counter_prefix", "label": "Prefix", "info": "Text before number" },
        { "type": "text", "id": "counter_suffix", "label": "Suffix", "info": "Text after number e.g. + or %" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "stat", "settings": { "value": "14k+", "counter_end": "14000", "counter_suffix": "+", "label": "patients served" } },
        { "type": "stat", "settings": { "value": "4.9 ★", "label": "1,200+ reviews" } },
        { "type": "stat", "settings": { "value": "1,247", "counter_end": "1247", "label": "kits sponsored" } },
        { "type": "stat", "settings": { "value": "<1%", "label": "return rate" } }
      ]
    }
  ]
}
{% endschema %}
