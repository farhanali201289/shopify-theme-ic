{%- liquid
  assign per_page = section.settings.products_per_page
-%}

{%- comment -%} Education / banner header {%- endcomment -%}
<div class="collection-hero">
  <div class="page-width">
    {%- if section.settings.show_title -%}
      <span class="eyebrow">{{ collection.title }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="section-heading" style="font-size:clamp(22px,3vw,30px); margin-bottom:8px;">{{ section.settings.heading }}</h1>
    {%- elsif collection.title != blank -%}
      <h1 class="section-heading" style="font-size:clamp(22px,3vw,30px); margin-bottom:8px;">{{ collection.title }}</h1>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="section-subtext">{{ section.settings.subtext }}</p>
    {%- elsif collection.description != blank -%}
      <div class="rte section-subtext">{{ collection.description }}</div>
    {%- endif -%}
    <div class="pdp__trust" style="margin-top:14px; justify-content:flex-start;">
      <span>✓ Free size exchange</span><span>✓ 14,000+ patients served</span><span>✓ Free shipping $75+</span><span>✓ 30-day return</span>
    </div>
  </div>
</div>

<section class="section">
  <div class="page-width">
    {%- paginate collection.products by per_page -%}
    <div class="collection-layout">

      {%- comment -%} Facets {%- endcomment -%}
      <aside class="facets">
        <form method="get">
          {%- comment -%} keep current sort {%- endcomment -%}
          {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}

          {%- if collection.filters.size > 0 -%}
            {%- for filter in collection.filters -%}
              <details class="facet-group" open>
                <summary class="facet-group__label">
                  {{ filter.label }}
                  <span>＋</span>
                </summary>
                <div style="margin-top:10px;">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div style="display:flex; gap:8px;">
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" inputmode="decimal">
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" inputmode="decimal">
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="facet-option">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          {{ value.label }} ({{ value.count }})
                        </label>
                      {%- endfor -%}
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
            <button type="submit" class="btn btn--accent btn--sm btn--full" style="margin-top:6px;">Apply filters</button>
            <a href="{{ collection.url }}" class="link-underline" style="display:inline-block; margin-top:12px;">Clear all</a>
          {%- else -%}
            <p style="font-size:12px; color:var(--taupe);">Add storefront filters in Shopify admin → Search &amp; Discovery to enable faceted filtering here.</p>
          {%- endif -%}
        </form>
      </aside>

      {%- comment -%} Grid {%- endcomment -%}
      <div>
        <div class="collection-toolbar">
          <span class="collection-count">{{ 'collections.showing' | t: count: collection.products_count }}</span>
          {%- if section.settings.show_sort -%}
            <form method="get">
              {%- for f in collection.filters -%}{%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}{%- endfor -%}
              <label style="font-size:12px; color:var(--taupe); margin-right:6px;">{{ 'collections.sort_by' | t }}</label>
              <select name="sort_by" onchange="this.form.submit()" style="width:auto; display:inline-block;">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </form>
          {%- endif -%}
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="product-grid grid-{{ section.settings.columns }}">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" style="display:flex; gap:8px; justify-content:center; margin-top:40px; align-items:center;" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--secondary btn--sm">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" style="font-size:13px; padding:4px 10px; color:var(--taupe);">{{ part.title }}</a>
                {%- else -%}
                  <span style="font-size:13px; padding:4px 10px; color:var(--brown); font-weight:700;">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--secondary btn--sm">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p style="color:var(--taupe); padding:40px 0;">No products in this collection yet.</p>
        {%- endif -%}
      </div>
    </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Custom heading (blank = collection title)" },
    { "type": "richtext", "id": "subtext", "label": "Custom intro (blank = collection description)" },
    { "type": "checkbox", "id": "show_title", "label": "Show collection name eyebrow", "default": true },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true }
  ]
}
{% endschema %}
