{%- liquid
  assign eb_lh = section.settings.eb_lh | times: 1.0 | divided_by: 10.0
  assign eb_ls = section.settings.eb_ls | times: 1.0 | divided_by: 100.0
  assign eb_lh_m = section.settings.eb_lh_m | times: 1.0 | divided_by: 10.0
  assign eb_ls_m = section.settings.eb_ls_m | times: 1.0 | divided_by: 100.0

  assign h_lh = section.settings.h_lh | times: 1.0 | divided_by: 10.0
  assign h_ls = section.settings.h_ls | times: 1.0 | divided_by: 100.0
  assign h_lh_m = section.settings.h_lh_m | times: 1.0 | divided_by: 10.0
  assign h_ls_m = section.settings.h_ls_m | times: 1.0 | divided_by: 100.0

  assign t_lh = section.settings.t_lh | times: 1.0 | divided_by: 10.0
  assign t_ls = section.settings.t_ls | times: 1.0 | divided_by: 100.0
  assign t_lh_m = section.settings.t_lh_m | times: 1.0 | divided_by: 10.0
  assign t_ls_m = section.settings.t_ls_m | times: 1.0 | divided_by: 100.0
-%}

<section class="section" id="kit-finder-{{ section.id }}">
  <div class="page-width">
    <div class="kf-intro">
      {%- if section.settings.eyebrow != blank -%}<span class="kf-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="kf-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="kf-text">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="chip-row" style="justify-content:center;" data-kf-chips>
        {%- for block in section.blocks -%}
          {%- assign chip_coll = collections[block.settings.collection] -%}
          <button class="chip kf-chip {% if forloop.first %}is-active{% endif %}"
            data-kf-chip="{{ block.id }}"
            data-kf-coll-url="{{ chip_coll.url | default: '#' }}"
            {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign chip_coll = collections[block.settings.collection] -%}
      <div class="scroller kit-scroller kf-track {% unless forloop.first %}kf-track--hidden{% endunless %}" data-kf-track="{{ block.id }}" data-scroller>
        <button class="scroller__btn scroller__btn--prev" data-scroller-btn="prev" aria-label="Previous">&#8592;</button>
        <button class="scroller__btn scroller__btn--next" data-scroller-btn="next" aria-label="Next">&#8594;</button>
        <div class="scroller__track" data-scroller-track>
          {%- if section.settings.byo_enabled -%}
            <a href="{{ chip_coll.url | default: '#' }}" class="kit-card kit-card--byo" data-kf-byo>
              <div class="kit-card__body">
                <div>
                  <div class="kit-card__eyebrow" style="color:#F7E9C9;">Most flexible</div>
                  <div class="kit-card__title" style="color:#FCEFD6; font-size:28px;">Design your own kit</div>
                  <p style="font-size:13.5px; color:#F3D9B8; line-height:1.6; margin-top:8px;">Pick <strong style="color:#FCEFD6;">any 3 pieces</strong> across any category — we'll take <strong style="color:#FCEFD6;">20% off</strong> automatically.</p>
                </div>
                <span class="kit-card__btn" style="background:#F7E9C9; color:#6B2E1E;">Start building →</span>
              </div>
            </a>
          {%- endif -%}

          {%- if chip_coll != blank -%}
            {%- for product in chip_coll.products limit: section.settings.product_limit -%}
              {% render 'kit-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="kit-card"><div class="kit-card__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="kit-card__body"><div class="kit-card__title">Select a collection</div><div class="kit-card__subtitle">Set a collection on this filter chip in the theme editor.</div></div></div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if section.settings.button_label != blank -%}
      <div style="text-align:center; margin-top:28px;">
        <a href="{{ section.settings.button_link }}" class="link-underline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  {%- capture s -%}#kit-finder-{{ section.id }}{%- endcapture -%}

  {{ s }} .kf-intro { text-align: center; max-width: 680px; margin: 0 auto 24px; }
  {{ s }} .kf-track--hidden { display: none; }

  {{ s }} .kf-eyebrow {
    display: block; text-transform: uppercase; margin-bottom: 8px;
    color: {{ section.settings.eb_color | default: 'inherit' }};
    font-size: {{ section.settings.eb_size }}px;
    font-weight: {{ section.settings.eb_weight }};
    text-align: {{ section.settings.eb_align }};
    line-height: {{ eb_lh }};
    letter-spacing: {{ eb_ls }}em;
  }
  {{ s }} .kf-heading {
    color: {{ section.settings.h_color | default: 'inherit' }};
    font-size: {{ section.settings.h_size }}px;
    font-weight: {{ section.settings.h_weight }};
    text-align: {{ section.settings.h_align }};
    line-height: {{ h_lh }};
    letter-spacing: {{ h_ls }}em;
  }
  {{ s }} .kf-text {
    margin: 14px auto 0;
    color: {{ section.settings.t_color | default: 'inherit' }};
    font-size: {{ section.settings.t_size }}px;
    font-weight: {{ section.settings.t_weight }};
    text-align: {{ section.settings.t_align }};
    line-height: {{ t_lh }};
    letter-spacing: {{ t_ls }}em;
  }
  {{ s }} .kf-chip {
    font-size: {{ section.settings.chip_size }}px;
    font-weight: {{ section.settings.chip_weight }};
    color: {{ section.settings.chip_color | default: 'var(--brown)' }};
    letter-spacing: {{ section.settings.chip_ls | times: 1.0 | divided_by: 100.0 }}em;
  }
  {{ s }} .kf-chip.is-active {
    background: {{ section.settings.chip_active_bg | default: 'var(--brown)' }};
    color: {{ section.settings.chip_active_color | default: '#fff' }};
    border-color: {{ section.settings.chip_active_bg | default: 'var(--brown)' }};
  }

  @media (max-width: 749px) {
    {{ s }} .kf-eyebrow {
      font-size: {{ section.settings.eb_size_m }}px;
      font-weight: {{ section.settings.eb_weight_m }};
      text-align: {{ section.settings.eb_align_m }};
      line-height: {{ eb_lh_m }};
      letter-spacing: {{ eb_ls_m }}em;
    }
    {{ s }} .kf-heading {
      font-size: {{ section.settings.h_size_m }}px;
      font-weight: {{ section.settings.h_weight_m }};
      text-align: {{ section.settings.h_align_m }};
      line-height: {{ h_lh_m }};
      letter-spacing: {{ h_ls_m }}em;
    }
    {{ s }} .kf-text {
      font-size: {{ section.settings.t_size_m }}px;
      font-weight: {{ section.settings.t_weight_m }};
      text-align: {{ section.settings.t_align_m }};
      line-height: {{ t_lh_m }};
      letter-spacing: {{ t_ls_m }}em;
    }
    {{ s }} .kf-chip {
      font-size: {{ section.settings.chip_size_m }}px;
      font-weight: {{ section.settings.chip_weight_m }};
    }
  }
</style>

<script>
(function(){
  var section = document.getElementById('kit-finder-{{ section.id }}');
  if (!section) return;
  var chips = section.querySelectorAll('[data-kf-chip]');
  var tracks = section.querySelectorAll('[data-kf-track]');
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      var id = chip.dataset.kfChip;
      chips.forEach(function(c){ c.classList.toggle('is-active', c === chip); });
      tracks.forEach(function(t){ t.classList.toggle('kf-track--hidden', t.dataset.kfTrack !== id); });
    });
  });
})();
</script>

<style>{% render 'section-spacing', sid: section.id, s: section.settings %}</style>

{% schema %}
