<section class="section--tight" style="background: var(--sand); border-top: 1px solid var(--border); text-align:center;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div style="font-family:var(--font-heading); font-size:19px; color:var(--gift); margin-bottom:12px; line-height:1.3;">{{ section.settings.heading }}</div>
    {%- endif -%}
    <div style="font-family:var(--font-body); font-size:14px; color:#3A2C24; display:flex; flex-wrap:wrap; gap:10px 22px; justify-content:center; align-items:center;">
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 -%}<span style="color:var(--border);">|</span>{%- endif -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <div style="font-family:var(--font-heading); font-style:italic; font-size:15px; color:var(--taupe); margin-top:12px;">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offer band",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<strong>Any 3 pieces — 20% off.</strong> Pick a ready-made kit, or build your own." },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "default": "<p>Most orders ship same day, so you're ready for whatever's next.</p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Offer item",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "<strong>Free recovery guide</strong> with every kit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer band",
      "blocks": [
        { "type": "item", "settings": { "text": "<strong>Free recovery guide</strong> with every kit" } },
        { "type": "item", "settings": { "text": "<strong>Free shipping</strong> over $75" } },
        { "type": "item", "settings": { "text": "<strong>30-day</strong> feel-like-yourself guarantee" } }
      ]
    }
  ]
}
{% endschema %}
