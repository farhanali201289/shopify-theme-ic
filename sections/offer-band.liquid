<section class="section--tight" style="background: var(--sand); border-top: 1px solid var(--border); text-align:center;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div style="font-family:var(--font-heading); font-size:19px; color:var(--gift); margin-bottom:12px; line-height:1.3;">{{ section.settings.heading }}</div>
    {%- endif -%}
    <div style="font-family:var(--font-body); font-size:14px; color:#3A2C24; display:flex; flex-wrap:wrap; gap:10px 22px; justify-content:center; align-items:center;">
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 -%}<span style="color:var(--border);">|</span>{%- endif -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <div style="font-family:var(--font-heading); font-style:italic; font-size:15px; color:var(--taupe); margin-top:12px;">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

<style>{% render 'section-spacing', sid: section.id, s: section.settings %}</style>

{% schema %}
{
  "name": "Offer band",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<strong>Any 3 pieces — 20% off.</strong> Pick a ready-made kit, or build your own." },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "default": "<p>Most orders ship same day, so you're ready for whatever's next.</p>" },
    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_bottom_unit", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "section_width", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" },
    { "type": "header", "content": "Padding — Mobile" },
    { "type": "range", "id": "padding_top_mob", "label": "Padding top", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_top_unit_mob", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "padding_bottom_mob", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_bottom_unit_mob", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "section_width_mob", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit_mob", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Offer item",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "<strong>Free recovery guide</strong> with every kit" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer band",
      "blocks": [
        { "type": "item", "settings": { "text": "<strong>Free recovery guide</strong> with every kit" } },
        { "type": "item", "settings": { "text": "<strong>Free shipping</strong> over $75" } },
        { "type": "item", "settings": { "text": "<strong>30-day</strong> feel-like-yourself guarantee" } }
      ]
    }
  ]
}
{% endschema %}
