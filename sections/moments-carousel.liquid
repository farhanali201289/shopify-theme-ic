<section class="section section--tight">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" style="text-align:center; margin-bottom:24px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="scroller" data-scroller>
      <button class="scroller__btn scroller__btn--prev" data-scroller-btn="prev" aria-label="Previous">&#8592;</button>
      <button class="scroller__btn scroller__btn--next" data-scroller-btn="next" aria-label="Next">&#8594;</button>
      <div class="scroller__track" data-scroller-track>
        {%- for block in section.blocks -%}
          <figure class="moment-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 680 | image_tag: loading: 'lazy', alt: block.settings.caption | strip_html }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moments carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moments carousel",
      "blocks": [
        { "type": "moment", "settings": { "caption": "Day 4 at home — drains managed, book in hand." } },
        { "type": "moment", "settings": { "caption": "Sleeves that open for the nurse — not for the room." } },
        { "type": "moment", "settings": { "caption": "Dressed by herself, week one." } },
        { "type": "moment", "settings": { "caption": "Not a hospital gown. Hers." } }
      ]
    }
  ]
}
{% endschema %}
