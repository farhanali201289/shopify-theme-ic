    { "type": "color", "id": "b_color", "label": "Color" },
    { "type": "header", "content": "Button — Desktop" },
    { "type": "range", "id": "b_size", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 13, "unit": "px" },
    { "type": "select", "id": "b_weight", "label": "Weight", "options": [{"value":"300","label":"Light"},{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra-bold"}], "default": "600" },
    { "type": "select", "id": "b_align", "label": "Align", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "range", "id": "b_lh", "label": "Line height (÷10)", "min": 10, "max": 25, "step": 1, "default": 14 },
    { "type": "range", "id": "b_ls", "label": "Spacing (÷100 em)", "min": 0, "max": 20, "step": 1, "default": 0 },
    { "type": "header", "content": "Button — Mobile" },
    { "type": "range", "id": "b_size_m", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 12, "unit": "px" },
    { "type": "select", "id": "b_weight_m", "label": "Weight", "options": [{"value":"300","label":"Light"},{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra-bold"}], "default": "600" },
    { "type": "select", "id": "b_align_m", "label": "Align", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "range", "id": "b_lh_m", "label": "Line height (÷10)", "min": 10, "max": 25, "step": 1, "default": 14 },
    { "type": "range", "id": "b_ls_m", "label": "Spacing (÷100 em)", "min": 0, "max": 20, "step": 1, "default": 0 },

    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
