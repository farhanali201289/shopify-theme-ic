<section class="hero" aria-label="{{ section.settings.title | strip_html | default: 'Hero' }}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.video_url != blank -%}
      <video autoplay muted loop playsinline {% if section.settings.poster %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.title | strip_html }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}

    <div class="hero__overlay">
      {%- if section.settings.eyebrow != blank -%}<div class="hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.title != blank -%}<h1 class="hero__title">{{ section.settings.title }}</h1>{%- endif -%}
      {%- if section.settings.subtitle != blank -%}<p class="hero__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
      {%- if section.settings.prompt != blank -%}<div class="hero__prompt">{{ section.settings.prompt }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__chips">
          {%- for block in section.blocks -%}
            <a class="hero__chip" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Hosted video" },
    { "type": "video_url", "id": "video_url", "label": "External video URL (mp4)", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "poster", "label": "Video poster / fallback" },
    { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Clothing engineered for treatment" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "You don’t have to figure this out alone." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Clothing built with hundreds of patients and nurses — for drains, ports, and dressing yourself." },
    { "type": "text", "id": "prompt", "label": "Chip prompt", "default": "Which one is yours?" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Condition chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Dialysis" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video hero",
      "blocks": [
        { "type": "chip", "settings": { "label": "Dialysis" } },
        { "type": "chip", "settings": { "label": "IV & Infusions" } },
        { "type": "chip", "settings": { "label": "Mastectomy" } },
        { "type": "chip", "settings": { "label": "Post-Surgery" } },
        { "type": "chip", "settings": { "label": "Chemotherapy" } },
        { "type": "chip", "settings": { "label": "Gifting for someone" } }
      ]
    }
  ]
}
{% endschema %}
