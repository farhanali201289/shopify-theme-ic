    { "type": "range", "id": "chip_size_mob", "label": "Font size", "min": 8, "max": 24, "step": 1, "default": 10, "unit": "px" },
    { "type": "select", "id": "chip_weight_mob", "label": "Font weight", "options": [{"value":"300","label":"Light"},{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra-bold"}], "default": "700" },
    { "type": "select", "id": "chip_align_mob", "label": "Alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "range", "id": "chip_lh_mob", "label": "Line height (÷10)", "min": 10, "max": 25, "step": 1, "default": 14 },
    { "type": "range", "id": "chip_ls_mob", "label": "Letter spacing (÷100 em)", "min": 0, "max": 30, "step": 1, "default": 18 },
