<section class="section" style="background: var(--sand);">
  <div class="page-width">
    <div style="text-align:center; margin-bottom:40px;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    </div>

    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="product-grid grid-3" style="border:1px solid var(--border); border-radius:var(--card-radius); overflow:hidden; gap:0; margin-bottom:40px;">
        {%- for block in stat_blocks -%}
          <div style="background:var(--cream); padding:24px; text-align:center; {% unless forloop.last %}border-right:1px solid var(--border);{% endunless %}" {{ block.shopify_attributes }}>
            <div style="font-family:var(--font-heading); font-size:48px; color:var(--accent); line-height:1;">{{ block.settings.number }}</div>
            <div style="font-family:var(--font-body); font-size:12px; color:var(--taupe); line-height:1.5; max-width:200px; margin:6px auto 0;">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign video_blocks = section.blocks | where: 'type', 'video' -%}
    {%- if video_blocks.size > 0 -%}
      <div class="voice-videos">
        {%- for block in video_blocks -%}
          {%- assign vlink = block.settings.link | default: '#' -%}
          <a class="voice-video" href="{{ vlink }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- endif -%}
            <span class="voice-video__play">&#9654;</span>
            <span class="voice-video__label">
              {%- if block.settings.category != blank -%}<span class="voice-video__cat">{{ block.settings.category }}</span>{%- endif -%}
              <span class="voice-video__name">{{ block.settings.name }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}

    {%- if tab_blocks.size > 0 and review_blocks.size > 0 -%}
      <div class="voice-tabs-label">{{ section.settings.filter_label }}</div>
      <div class="voice-tabs" data-filter-group data-filter-target="#voice-reviews-{{ section.id }}">
        {%- for block in tab_blocks -%}
          <button class="voice-tab {% if forloop.first %}is-active{% endif %}" data-filter="{{ block.settings.value | default: 'all' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if review_blocks.size > 0 -%}
      <div class="product-grid grid-3 review-row" id="voice-reviews-{{ section.id }}">
        {%- for block in review_blocks -%}
          <div class="review-card" data-filter-item="{{ block.settings.category | default: 'all' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.avatar != blank -%}
              {{ block.settings.avatar | image_url: width: 88 | image_tag: loading: 'lazy', class: 'review-card__avatar', alt: block.settings.name }}
            {%- else -%}
              <div class="review-card__avatar--initial">{{ block.settings.name | strip | slice: 0 }}</div>
            {%- endif -%}
            <div class="review-card__stars">★★★★★</div>
            <blockquote>{{ block.settings.quote }}</blockquote>
            <div class="review-card__name">{{ block.settings.name }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>{% render 'section-spacing', sid: section.id, s: section.settings %}</style>

{% schema %}
{
  "name": "Patient voices",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What patients say" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>You'll feel the difference <em>at your very next appointment.</em></p>" },
    { "type": "text", "id": "filter_label", "label": "Filter row label", "default": "Filter patient stories" },
    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_bottom_unit", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "section_width", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" },
    { "type": "header", "content": "Padding — Mobile" },
    { "type": "range", "id": "padding_top_mob", "label": "Padding top", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_top_unit_mob", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "padding_bottom_mob", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "default": 0, "unit": "px" },
    { "type": "select", "id": "padding_bottom_unit_mob", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "px" },
    { "type": "range", "id": "section_width_mob", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit_mob", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "89%" },
        { "type": "text", "id": "label", "label": "Label", "default": "felt more confident at their treatment appointment" }
      ]
    },
    {
      "type": "video",
      "name": "Video tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "url", "id": "link", "label": "Video link" },
        { "type": "text", "id": "category", "label": "Category label", "default": "Feeling like myself" },
        { "type": "text", "id": "name", "label": "Name / caption", "default": "Maria R. · Mastectomy" }
      ]
    },
    {
      "type": "tab",
      "name": "Filter tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All" },
        { "type": "text", "id": "value", "label": "Filter value ('all' shows everything)", "default": "all" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional — initial used if empty)" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I wore the camisole home from the hospital. The drain pockets are the thing nobody else makes." },
        { "type": "text", "id": "name", "label": "Name", "default": "Maria R. · DCIS, double mastectomy" },
        { "type": "text", "id": "category", "label": "Category (matches a filter tab value)", "default": "myself" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Patient voices",
      "blocks": [
        { "type": "stat", "settings": { "number": "89%", "label": "felt more confident at their treatment appointment" } },
        { "type": "stat", "settings": { "number": "3.2×", "label": "faster nurse access during infusion vs standard clothing" } },
        { "type": "stat", "settings": { "number": "94%", "label": "would recommend Inspired Comforts to another patient" } },
        { "type": "video", "settings": { "category": "Feeling like myself", "name": "Maria R. · Mastectomy" } },
        { "type": "video", "settings": { "category": "Getting through treatment", "name": "Diane K. · Chemo, cycle 4" } },
        { "type": "video", "settings": { "category": "Caregiver moments", "name": "James T. · Dialysis" } },
        { "type": "video", "settings": { "category": "First appointment", "name": "Anita P. · Bilateral mastectomy" } },
        { "type": "video", "settings": { "category": "Going home", "name": "Rosa M. · Hip replacement" } },
        { "type": "video", "settings": { "category": "Caregiver moments", "name": "Tom W. · His wife's chemo" } },
        { "type": "tab", "settings": { "label": "All", "value": "all" } },
        { "type": "tab", "settings": { "label": "Feeling Like Myself", "value": "myself" } },
        { "type": "tab", "settings": { "label": "Getting Through Treatment", "value": "treatment" } },
        { "type": "tab", "settings": { "label": "Caregiver Moments", "value": "caregiver" } },
        { "type": "tab", "settings": { "label": "First Appointment", "value": "appointment" } },
        { "type": "tab", "settings": { "label": "Going Home", "value": "home" } },
        { "type": "review", "settings": { "quote": "I wore the camisole home from the hospital. Three weeks later I still hadn't taken it off. The drain pockets are the thing nobody else makes.", "name": "Maria R. · DCIS, double mastectomy", "category": "myself" } },
        { "type": "review", "settings": { "quote": "The nurse didn't have to ask me to lift anything. I just rolled up the sleeve. At cycle 4 it meant everything.", "name": "Diane K. · Breast cancer, chemo", "category": "treatment" } },
        { "type": "review", "settings": { "quote": "My husband bought the care package. He'd never have known what to look for. I cried when I opened it.", "name": "Anita P. · Bilateral mastectomy", "category": "caregiver" } }
      ]
    }
  ]
}
{% endschema %}
