    { "type": "header", "content": "Filter label — Mobile" },
    { "type": "range", "id": "f_size_m", "label": "Font size", "min": 8, "max": 24, "step": 1, "default": 10, "unit": "px" },
    { "type": "select", "id": "f_weight_m", "label": "Weight", "options": [{"value":"300","label":"Light"},{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra-bold"}], "default": "700" },
    { "type": "range", "id": "f_lh_m", "label": "Line height (÷10)", "min": 10, "max": 25, "step": 1, "default": 14 },
    { "type": "range", "id": "f_ls_m", "label": "Spacing (÷100 em)", "min": 0, "max": 30, "step": 1, "default": 16 },

    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
