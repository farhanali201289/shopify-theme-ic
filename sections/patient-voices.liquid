  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "89%" },
        { "type": "text", "id": "label", "label": "Label", "default": "felt more confident at their treatment appointment" }
      ]
    },
    {
      "type": "video",
      "name": "Video tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "url", "id": "link", "label": "Video link" },
        { "type": "text", "id": "category", "label": "Category label", "default": "Feeling like myself" },
        { "type": "text", "id": "name", "label": "Name / caption", "default": "Maria R. · Mastectomy" }
      ]
    },
    {
      "type": "tab",
      "name": "Filter tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All" },
        { "type": "text", "id": "value", "label": "Filter value ('all' shows everything)", "default": "all" }
