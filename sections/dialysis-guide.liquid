  "presets": [
    {
      "name": "Dialysis Guide",
      "blocks": [
        { "type": "toc_item", "settings": { "num": "01", "title": "Understanding dialysis", "sub": "What it does, and the two main types.", "target": "dg-ch1" } },
        { "type": "toc_item", "settings": { "num": "02", "title": "Your access", "sub": "Fistula, graft, or catheter — what each means.", "target": "dg-ch2" } },
        { "type": "toc_item", "settings": { "num": "03", "title": "A session, hour by hour", "sub": "What actually happens in the chair.", "target": "dg-ch3" } },
        { "type": "toc_item", "settings": { "num": "04", "title": "What to wear & pack", "sub": "The session-day checklist.", "target": "dg-ch4" } },
        { "type": "toc_item", "settings": { "num": "05", "title": "Living well on dialysis", "sub": "Work, travel, diet, and feeling like you.", "target": "dg-ch5" } },
        { "type": "toc_item", "settings": { "num": "06", "title": "Common questions", "sub": "Answers to what patients ask most.", "target": "dg-faq" } },
        { "type": "stat", "settings": { "number": "3×", "label": "a week is the most common in-centre schedule" } },
        { "type": "stat", "settings": { "number": "4 hrs", "label": "the typical length of a single session" } },
        { "type": "stat", "settings": { "number": "2M+", "label": "people worldwide manage life with dialysis" } },
        { "type": "stat", "settings": { "number": "Full", "label": "lives — work, travel, family — are absolutely possible" } },
        { "type": "access", "settings": { "title": "Fistula", "body": "A surgically joined vein and artery in your arm, and the most common long-term access. It needs to stay reachable during the whole session — and kept warm and protected in between.", "tip": "Clothing: a sleeve that opens fully to the upper arm, so it never has to be rolled or removed." } },
        { "type": "access", "settings": { "title": "Graft", "body": "A soft tube placed under the skin to connect a vein and artery, used when a fistula isn't suitable. Cared for much like a fistula, with the same warmth and access needs.", "tip": "Clothing: wide, non-compressive sleeves — nothing tight over the graft site." } },
        { "type": "access", "settings": { "title": "Catheter", "body": "A line in the neck or chest, often used while a fistula matures. Needs to stay clean and dry, with the dressing kept covered.", "tip": "Clothing: a front-open top so the team can reach the line without anything going over your head." } },
        { "type": "timeline", "settings": { "when": "Arrival", "title": "Weigh-in and settling", "body": "You're weighed to measure fluid gained since last time, then settled into your chair. Bring a warm layer — centres run cold by design." } },
        { "type": "timeline", "settings": { "when": "First 15 min", "title": "Connection", "body": "A nurse connects your access to the machine. With a fistula this means two needles; with a catheter, the line is attached. A sleeve that opens fully makes this quick and private." } },
        { "type": "timeline", "settings": { "when": "~4 hours", "title": "The run", "body": "Your blood is filtered and returned, continuously. Your access arm stays still — most people read, watch something, nap, or work one-handed. Warmth and comfort matter most here." } },
        { "type": "timeline", "settings": { "when": "Last 15 min", "title": "Disconnection", "body": "The machine returns the last of your blood, needles come out, and pressure is held on the site until bleeding stops. You're weighed again before you leave." } },
        { "type": "timeline", "settings": { "when": "After", "title": "Recovery", "body": "Some people feel tired or washed-out afterwards, others feel fine. Plan a gentle rest of day for your first few sessions until you know how your body responds." } },
        { "type": "check", "settings": { "title": "A sleeve-access top or hoodie", "body": "Opens fully for fistula or graft access — warm, but never in the way." } },
        { "type": "check", "settings": { "title": "A lap-size warm blanket", "body": "Not king-size — large blankets catch on tubing." } },
        { "type": "check", "settings": { "title": "Headphones & a tablet on a stand", "body": "Your access arm stays still, so one-handed entertainment wins." } },
        { "type": "check", "settings": { "title": "Warm socks & a neck pillow", "body": "Feet get cold even under a blanket; an arm-support pillow eases strain." } },
        { "type": "check", "settings": { "title": "Approved snacks & a water bottle", "body": "Check with your dietitian about fluid and what's right for you." } },
        { "type": "check", "settings": { "title": "A small bag for it all", "body": "Pack it the night before so a session day never starts in a rush." } },
        { "type": "well", "settings": { "title": "Work & routine", "body": "Many people keep working. If you have an evening class or shift, ask about a day-time slot — schedule dialysis around your life, not your life around dialysis." } },
        { "type": "well", "settings": { "title": "Travel", "body": "Dialysis centres exist in most cities and countries. With a few weeks' notice, your unit can help arrange sessions away from home so you can still take the trip." } },
        { "type": "well", "settings": { "title": "Diet & fluid", "body": "Your dietitian will guide you on fluid, potassium, phosphate, and salt. It feels like a lot at first — within a few weeks it becomes second nature." } },
        { "type": "well", "settings": { "title": "Staying warm", "body": "Cold sensitivity is real — centres are air-conditioned and dialysis lowers your core temperature. Layers you can add and remove one-handed make every session easier." } },
        { "type": "well", "settings": { "title": "Your emotions", "body": "It's normal to feel a wave of grief, anger, or fear early on. Talk to your team, lean on others on the same path, and be patient with yourself." } },
        { "type": "well", "settings": { "title": "Feeling like you", "body": "You are not a patient in a gown — you're you, going to an appointment. Clothing that looks and feels like your own changes how the whole day feels." } },
        { "type": "faq", "settings": { "question": "Will dialysis hurt?", "open": true, "answer": "<p>Connecting a fistula involves two needles, which can sting at first — most people find it becomes very manageable, and numbing cream is available. A catheter connection isn't painful. The run itself shouldn't hurt; tell your nurse if anything feels wrong.</p>" } },
        { "type": "faq", "settings": { "question": "How should I dress for a session?", "answer": "<p>Wear something warm with easy access to your arm (for a fistula or graft) or chest (for a catheter). Sleeve-zip tops, button or snap fronts, and soft layers you can add and remove with one hand are ideal. Avoid anything tight over the access site.</p>" } },
        { "type": "faq", "settings": { "question": "Can I still travel?", "answer": "<p>Yes. With planning, your unit can arrange holiday dialysis at a centre near your destination. Give a few weeks' notice and carry a summary of your treatment details with you.</p>" } },
        { "type": "faq", "settings": { "question": "Will I be able to keep working?", "answer": "<p>Many people do. Talk to your unit about scheduling sessions around your hours — early-morning, evening, or weekend slots are often available, and home dialysis offers even more flexibility.</p>" } },
        { "type": "faq", "settings": { "question": "Why am I so cold during treatment?", "answer": "<p>Centres are kept cool for infection control, and dialysis itself lowers your core temperature. Anaemia, common in kidney disease, can add to it. A warm layer that still allows access is the single most-recommended comfort item.</p>" } }
      ]
    }
  ]
}
