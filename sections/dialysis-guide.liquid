    { "type": "text", "id": "ch5_heading", "label": "Heading", "default": "Living well on dialysis" },
    { "type": "textarea", "id": "ch5_intro", "label": "Intro", "default": "Dialysis is a big part of life — but it doesn't have to be all of it. Patients work, study, travel, and stay close to the people they love." },

