{%- comment -%}
  Dialysis Guide — educational guide template section.
  Fixed regions (hero, chapters, quote, lead capture, shop CTA) are section settings.
  Repeating items (TOC, stats, access cards, timeline, checklist, living-well cards, FAQ)
  are blocks, grouped per region by block type. Fully mobile responsive (≤749px → 1 col).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign hero_img = s.hero_image | image_url: width: 1600
-%}

<section class="dg" id="dg-{{ sid }}">

  {%- comment -%} ── S1 HERO ── {%- endcomment -%}
  <div class="dg-hero"{% if hero_img %} style="background-image:linear-gradient(105deg,rgba(45,58,30,.92) 0%,rgba(45,58,30,.66) 48%,rgba(45,58,30,.30) 100%),url('{{ hero_img }}');"{% endif %}>
    <div class="dg-wrap">
      {%- if s.hero_eyebrow != blank -%}<div class="dg-eyebrow dg-eyebrow--gold">{{ s.hero_eyebrow }}</div>{%- endif -%}
      {%- if s.hero_heading != blank -%}<h1 class="dg-serif dg-hero-h">{{ s.hero_heading }}</h1>{%- endif -%}
      {%- if s.hero_text != blank -%}<p class="dg-hero-p">{{ s.hero_text }}</p>{%- endif -%}
      <div class="dg-meta">
        {%- if s.hero_meta1 != blank -%}<span>{{ s.hero_meta1 }}</span>{%- endif -%}
        {%- if s.hero_meta2 != blank -%}<span>{{ s.hero_meta2 }}</span>{%- endif -%}
        {%- if s.hero_meta3 != blank -%}<span>{{ s.hero_meta3 }}</span>{%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ── S2 TABLE OF CONTENTS ── {%- endcomment -%}
  {%- assign toc_blocks = section.blocks | where: 'type', 'toc_item' -%}
  {%- if toc_blocks.size > 0 -%}
    <div class="dg-section">
      <div class="dg-wrap">
        {%- if s.toc_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.toc_eyebrow }}</div>{%- endif -%}
        {%- if s.toc_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.toc_heading }}</div>{%- endif -%}
        <div class="dg-toc">
          {%- for block in toc_blocks -%}
            <button type="button" class="dg-toc-item" data-dg-target="{{ block.settings.target }}" {{ block.shopify_attributes }}>
              <div class="dg-toc-num">{{ block.settings.num }}</div>
              <div class="dg-toc-t">{{ block.settings.title }}</div>
              <div class="dg-toc-s">{{ block.settings.sub }}</div>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S3 STATS BAND ── {%- endcomment -%}
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
    <div class="dg-stats">
      {%- for block in stat_blocks -%}
        <div class="dg-stat" {{ block.shopify_attributes }}>
          <div class="dg-stat-n dg-serif">{{ block.settings.number }}</div>
          <div class="dg-stat-l">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ── S4 CHAPTER 1 — Understanding dialysis (split + image) ── {%- endcomment -%}
  {%- if s.ch1_heading != blank -%}
    <div class="dg-section" id="dg-ch1">
      <div class="dg-wrap">
        <div class="dg-split">
          <div>
            {%- if s.ch1_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.ch1_eyebrow }}</div>{%- endif -%}
            <div class="dg-h2 dg-serif">{{ s.ch1_heading }}</div>
            {%- if s.ch1_body != blank -%}<div class="dg-lead rte">{{ s.ch1_body }}</div>{%- endif -%}
          </div>
          {%- if s.ch1_image != blank -%}
            <div class="dg-split-media">{{ s.ch1_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: s.ch1_heading | strip_html, class: 'dg-split-img' }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S5 CHAPTER 2 — Your access (cards) ── {%- endcomment -%}
  {%- assign access_blocks = section.blocks | where: 'type', 'access' -%}
  {%- if s.ch2_heading != blank or access_blocks.size > 0 -%}
    <div class="dg-section dg-section--alt" id="dg-ch2">
      <div class="dg-wrap">
        {%- if s.ch2_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.ch2_eyebrow }}</div>{%- endif -%}
        {%- if s.ch2_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.ch2_heading }}</div>{%- endif -%}
        {%- if s.ch2_intro != blank -%}<p class="dg-lead">{{ s.ch2_intro }}</p>{%- endif -%}
        {%- if access_blocks.size > 0 -%}
          <div class="dg-card-grid">
            {%- for block in access_blocks -%}
              <div class="dg-card" {{ block.shopify_attributes }}>
                <h3 class="dg-serif">{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
                {%- if block.settings.tip != blank -%}<div class="dg-tip">{{ block.settings.tip }}</div>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if s.ch2_note != blank -%}<div class="dg-note">{{ s.ch2_note }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S6 CHAPTER 3 — A session, hour by hour (timeline) ── {%- endcomment -%}
  {%- assign tl_blocks = section.blocks | where: 'type', 'timeline' -%}
  {%- if s.ch3_heading != blank or tl_blocks.size > 0 -%}
    <div class="dg-section" id="dg-ch3">
      <div class="dg-wrap">
        {%- if s.ch3_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.ch3_eyebrow }}</div>{%- endif -%}
        {%- if s.ch3_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.ch3_heading }}</div>{%- endif -%}
        {%- if s.ch3_intro != blank -%}<p class="dg-lead">{{ s.ch3_intro }}</p>{%- endif -%}
        {%- if tl_blocks.size > 0 -%}
          <div class="dg-tl">
            {%- for block in tl_blocks -%}
              <div class="dg-tl-row" {{ block.shopify_attributes }}>
                <div class="dg-tl-when">{{ block.settings.when }}</div>
                <div>
                  <div class="dg-tl-t">{{ block.settings.title }}</div>
                  <div class="dg-tl-d">{{ block.settings.body }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S7 CHAPTER 4 — What to wear & pack (checklist) ── {%- endcomment -%}
  {%- assign check_blocks = section.blocks | where: 'type', 'check' -%}
  {%- if s.ch4_heading != blank or check_blocks.size > 0 -%}
    <div class="dg-section dg-section--alt" id="dg-ch4">
      <div class="dg-wrap">
        <div class="dg-split dg-split--flip">
          {%- if s.ch4_image != blank -%}
            <div class="dg-split-media">{{ s.ch4_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: s.ch4_heading | strip_html, class: 'dg-split-img' }}</div>
          {%- endif -%}
          <div>
            {%- if s.ch4_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.ch4_eyebrow }}</div>{%- endif -%}
            {%- if s.ch4_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.ch4_heading }}</div>{%- endif -%}
            {%- if s.ch4_intro != blank -%}<p class="dg-lead">{{ s.ch4_intro }}</p>{%- endif -%}
          </div>
        </div>
        {%- if check_blocks.size > 0 -%}
          <div class="dg-check">
            {%- for block in check_blocks -%}
              <div class="dg-ci" {{ block.shopify_attributes }}>
                <span class="dg-tick" aria-hidden="true"><svg viewBox="0 0 11 11" fill="none"><path d="M1.5 5.5l3 3 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <div>
                  <div class="dg-ci-t">{{ block.settings.title }}</div>
                  <div class="dg-ci-s">{{ block.settings.body }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if s.ch4_button_label != blank -%}
          <div class="dg-btn-row">
            <a class="dg-btn-outline" href="{{ s.ch4_button_link | default: '#' }}">{{ s.ch4_button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S8 CHAPTER 5 — Living well (cards) ── {%- endcomment -%}
  {%- assign well_blocks = section.blocks | where: 'type', 'well' -%}
  {%- if s.ch5_heading != blank or well_blocks.size > 0 -%}
    <div class="dg-section" id="dg-ch5">
      <div class="dg-wrap">
        {%- if s.ch5_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.ch5_eyebrow }}</div>{%- endif -%}
        {%- if s.ch5_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.ch5_heading }}</div>{%- endif -%}
        {%- if s.ch5_intro != blank -%}<p class="dg-lead">{{ s.ch5_intro }}</p>{%- endif -%}
        {%- if well_blocks.size > 0 -%}
          <div class="dg-card-grid">
            {%- for block in well_blocks -%}
              <div class="dg-card dg-card--accent" {{ block.shopify_attributes }}>
                <h3 class="dg-serif">{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S9 QUOTE ── {%- endcomment -%}
  {%- if s.quote_text != blank -%}
    <div class="dg-quote">
      <blockquote class="dg-serif">{{ s.quote_text }}</blockquote>
      {%- if s.quote_cite != blank -%}<cite>{{ s.quote_cite }}</cite>{%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} ── S10 FAQ (accordion) ── {%- endcomment -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
  {%- if faq_blocks.size > 0 -%}
    <div class="dg-section" id="dg-faq">
      <div class="dg-wrap dg-wrap--narrow">
        {%- if s.faq_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.faq_eyebrow }}</div>{%- endif -%}
        {%- if s.faq_heading != blank -%}<div class="dg-h2 dg-serif">{{ s.faq_heading }}</div>{%- endif -%}
        <div class="dg-faq">
          {%- for block in faq_blocks -%}
            <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="dg-faq-a rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S11 LEAD CAPTURE ── {%- endcomment -%}
  {%- if s.lead_heading != blank -%}
    <div class="dg-section dg-section--alt">
      <div class="dg-wrap">
        <div class="dg-lead-cap">
          <div>
            {%- if s.lead_eyebrow != blank -%}<div class="dg-eyebrow">{{ s.lead_eyebrow }}</div>{%- endif -%}
            <div class="dg-h2 dg-serif dg-h2--sm">{{ s.lead_heading }}</div>
            {%- if s.lead_bullets != blank -%}<div class="dg-lead-list rte">{{ s.lead_bullets }}</div>{%- endif -%}
          </div>
          <div>
            {%- form 'customer', class: 'dg-form' -%}
              <input type="hidden" name="contact[tags]" value="dialysis-guide,newsletter">
              <input type="email" name="contact[email]" placeholder="your@email.com" aria-label="Email" required>
              <button type="submit" class="dg-btn">{{ s.lead_button_label | default: 'Send my guide' }}</button>
            {%- endform -%}
            {%- if s.lead_note != blank -%}<div class="dg-lead-note">{{ s.lead_note }}</div>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── S12 SHOP CTA ── {%- endcomment -%}
  {%- if s.shop_heading != blank -%}
    <div class="dg-shop">
      <h2 class="dg-serif">{{ s.shop_heading }}</h2>
      {%- if s.shop_text != blank -%}<p>{{ s.shop_text }}</p>{%- endif -%}
      <div class="dg-shop-btns">
        {%- if s.shop_btn1_label != blank -%}<a class="dg-btn dg-btn--cream" href="{{ s.shop_btn1_link | default: '#' }}">{{ s.shop_btn1_label }}</a>{%- endif -%}
        {%- if s.shop_btn2_label != blank -%}<a class="dg-btn dg-btn--ghost" href="{{ s.shop_btn2_link | default: '#' }}">{{ s.shop_btn2_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  {%- capture sc -%}#shopify-section-{{ sid }}{%- endcapture -%}
  {{ sc }} .dg { --dg-sage: var(--accent, #5C6E3A); --dg-clay: var(--accent-dark, #3A4A28); --dg-accent: #9A4E3C; --dg-cream: var(--cream, #FCFAF4); --dg-sand: var(--sand, #F4F0E4); --dg-sand2: #F8F5EC; --dg-ink: var(--brown, #1D1A14); --dg-taupe: #6B6354; --dg-border: rgba(29,26,20,.10); background: var(--dg-cream); font-family: var(--font-body); }
  {{ sc }} .dg-serif { font-family: var(--font-heading); }
  {{ sc }} .dg-wrap { max-width: 1080px; margin: 0 auto; }
  {{ sc }} .dg-wrap--narrow { max-width: 760px; }
  {{ sc }} .dg-eyebrow { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--dg-sage); font-weight: 800; }
  {{ sc }} .dg-section { padding: 44px 48px; }
  {{ sc }} .dg-section--alt { background: var(--dg-sand2); }
  {{ sc }} .dg-h2 { font-family: var(--font-heading); font-size: 30px; font-weight: 600; color: var(--dg-ink); line-height: 1.15; margin-bottom: 8px; }
  {{ sc }} .dg-h2--sm { font-size: 24px; margin-top: 6px; }
  {{ sc }} .dg-lead { font-size: 14.5px; color: var(--dg-taupe); line-height: 1.8; max-width: 680px; }
  {{ sc }} .dg-lead em { color: var(--dg-ink); font-style: italic; }
  {{ sc }} .dg-note { margin-top: 16px; font-size: 12.5px; color: var(--dg-taupe); }
  /* Hero */
  {{ sc }} .dg-hero { position: relative; background: var(--dg-clay); background-size: cover; background-position: center 28%; padding: 56px 48px; }
  {{ sc }} .dg-hero .dg-wrap { max-width: 1080px; }
  {{ sc }} .dg-hero-h { font-size: 46px; font-weight: 600; color: var(--dg-cream); line-height: 1.08; margin: 12px 0 14px; max-width: 640px; text-shadow: 0 1px 14px rgba(0,0,0,.35); }
  {{ sc }} .dg-hero-p { font-size: 15px; color: rgba(255,255,255,.92); line-height: 1.7; max-width: 540px; margin-bottom: 20px; text-shadow: 0 1px 12px rgba(0,0,0,.35); }
  {{ sc }} .dg-eyebrow--gold { color: #F7E9C9; }
  {{ sc }} .dg-meta { display: flex; gap: 22px; flex-wrap: wrap; font-size: 12px; color: rgba(255,255,255,.85); }
  /* TOC */
  {{ sc }} .dg-toc { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-top: 20px; }
  {{ sc }} .dg-toc-item { text-align: left; background: #fff; border: 1px solid var(--dg-border); border-left: 3px solid var(--dg-sage); border-radius: 10px; padding: 14px 16px; cursor: pointer; transition: transform .12s, box-shadow .12s; font-family: var(--font-body); }
  {{ sc }} .dg-toc-item:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(45,58,30,.1); }
  {{ sc }} .dg-toc-num { font-family: var(--font-heading); font-size: 22px; color: var(--dg-sage); line-height: 1; }
  {{ sc }} .dg-toc-t { font-weight: 700; font-size: 13.5px; color: var(--dg-ink); margin-top: 4px; }
  {{ sc }} .dg-toc-s { font-size: 11.5px; color: var(--dg-taupe); margin-top: 2px; line-height: 1.5; }
  /* Stats */
  {{ sc }} .dg-stats { background: var(--dg-sage); display: grid; grid-template-columns: repeat(4,1fr); }
  {{ sc }} .dg-stat { padding: 30px 18px; text-align: center; border-right: 1px solid rgba(255,255,255,.16); }
  {{ sc }} .dg-stat:last-child { border-right: none; }
  {{ sc }} .dg-stat-n { font-size: 42px; color: #fff; line-height: 1; margin-bottom: 6px; }
  {{ sc }} .dg-stat-l { font-size: 11.5px; color: rgba(255,255,255,.7); line-height: 1.5; }
  /* Split / cards */
  {{ sc }} .dg-split { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: center; }
  {{ sc }} .dg-split-img { width: 100%; height: 300px; object-fit: cover; border-radius: 12px; display: block; }
  {{ sc }} .dg-card-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-top: 22px; }
  {{ sc }} .dg-card { background: #fff; border: 1px solid var(--dg-border); border-radius: 12px; padding: 22px 20px; border-top: 3px solid var(--dg-sage); }
  {{ sc }} .dg-card--accent { border-top-color: var(--dg-accent); }
  {{ sc }} .dg-card h3 { font-size: 20px; color: var(--dg-ink); margin-bottom: 6px; }
  {{ sc }} .dg-card p { font-size: 12.5px; color: var(--dg-taupe); line-height: 1.7; }
  {{ sc }} .dg-tip { margin-top: 10px; background: var(--dg-sand); border-left: 3px solid var(--dg-sage); padding: 8px 11px; font-size: 11.5px; color: var(--dg-ink); line-height: 1.5; border-radius: 0 6px 6px 0; }
  /* Timeline */
  {{ sc }} .dg-tl { display: flex; flex-direction: column; margin-top: 18px; }
  {{ sc }} .dg-tl-row { display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--dg-border); }
  {{ sc }} .dg-tl-row:first-child { border-top: 1px solid var(--dg-border); }
  {{ sc }} .dg-tl-when { font-family: var(--font-heading); font-size: 16px; font-weight: 600; color: var(--dg-sage); }
  {{ sc }} .dg-tl-t { font-weight: 700; font-size: 14px; color: var(--dg-ink); margin-bottom: 5px; }
  {{ sc }} .dg-tl-d { font-size: 13px; color: var(--dg-taupe); line-height: 1.7; }
  /* Checklist */
  {{ sc }} .dg-check { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px; margin-top: 18px; }
  {{ sc }} .dg-ci { display: flex; gap: 11px; align-items: flex-start; padding: 9px 0; border-bottom: 1px solid var(--dg-border); }
  {{ sc }} .dg-tick { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--dg-sage); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--dg-sage); margin-top: 1px; }
  {{ sc }} .dg-tick svg { width: 11px; height: 11px; }
  {{ sc }} .dg-ci-t { font-size: 13px; color: var(--dg-ink); font-weight: 600; }
  {{ sc }} .dg-ci-s { font-size: 11.5px; color: var(--dg-taupe); margin-top: 2px; line-height: 1.5; }
  {{ sc }} .dg-btn-row { margin-top: 20px; }
  /* FAQ */
  {{ sc }} .dg-faq { margin-top: 14px; }
  {{ sc }} .dg-faq details { border-bottom: 1px solid var(--dg-border); }
  {{ sc }} .dg-faq summary { list-style: none; cursor: pointer; padding: 16px 0; font-weight: 700; font-size: 14px; color: var(--dg-ink); display: flex; justify-content: space-between; align-items: center; gap: 14px; }
  {{ sc }} .dg-faq summary::-webkit-details-marker { display: none; }
  {{ sc }} .dg-faq summary::after { content: '+'; font-size: 20px; color: var(--dg-taupe); font-weight: 300; flex-shrink: 0; }
  {{ sc }} .dg-faq details[open] summary::after { content: '\2212'; }
  {{ sc }} .dg-faq-a { font-size: 13px; color: var(--dg-taupe); line-height: 1.8; padding-bottom: 16px; }
  /* Quote */
  {{ sc }} .dg-quote { background: var(--dg-ink); padding: 48px; text-align: center; }
  {{ sc }} .dg-quote blockquote { font-style: italic; font-size: 26px; color: #fff; line-height: 1.5; max-width: 680px; margin: 0 auto 14px; }
  {{ sc }} .dg-quote cite { font-size: 12px; color: rgba(255,255,255,.5); font-style: normal; letter-spacing: .06em; }
  /* Lead capture */
  {{ sc }} .dg-lead-cap { background: var(--dg-sand); border-radius: 14px; padding: 30px 34px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 30px; align-items: center; }
  {{ sc }} .dg-lead-list ul { list-style: none; margin: 12px 0 0; padding: 0; }
  {{ sc }} .dg-lead-list li { font-size: 12.5px; color: var(--dg-ink); line-height: 1.9; }
  {{ sc }} .dg-form { display: flex; gap: 8px; }
  {{ sc }} .dg-form input { flex: 1; padding: 13px 16px; border: 1.5px solid rgba(29,26,20,.15); border-radius: 10px; font-size: 13px; background: #fff; font-family: var(--font-body); }
  {{ sc }} .dg-lead-note { font-size: 11px; color: var(--dg-taupe); margin-top: 10px; }
  /* Buttons */
  {{ sc }} .dg-btn { display: inline-block; background: var(--dg-sage); color: #fff; border: none; padding: 13px 22px; border-radius: 10px; font-weight: 800; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; font-family: var(--font-body); white-space: nowrap; text-decoration: none; }
  {{ sc }} .dg-btn-outline { display: inline-block; background: #fff; color: var(--dg-clay); border: 1.5px solid var(--dg-sage); padding: 13px 22px; border-radius: 10px; font-weight: 800; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; font-family: var(--font-body); text-decoration: none; }
  {{ sc }} .dg-btn--cream { background: #F7E9C9; color: var(--dg-clay); }
  {{ sc }} .dg-btn--ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.55); }
  /* Shop CTA */
  {{ sc }} .dg-shop { background: linear-gradient(150deg, var(--dg-clay), var(--dg-sage)); padding: 44px 48px; text-align: center; }
  {{ sc }} .dg-shop h2 { font-size: 30px; color: var(--dg-cream); margin-bottom: 10px; }
  {{ sc }} .dg-shop p { font-size: 13.5px; color: rgba(255,255,255,.8); max-width: 520px; margin: 0 auto 22px; line-height: 1.7; }
  {{ sc }} .dg-shop-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  /* ── Mobile ── */
  @media (max-width: 749px) {
    {{ sc }} .dg-section { padding: 32px 20px; }
    {{ sc }} .dg-hero { padding: 40px 22px; }
    {{ sc }} .dg-hero-h { font-size: 32px; }
    {{ sc }} .dg-h2 { font-size: 25px; }
    {{ sc }} .dg-toc { grid-template-columns: 1fr; }
    {{ sc }} .dg-stats { grid-template-columns: 1fr 1fr; }
    {{ sc }} .dg-stat:nth-child(2) { border-right: none; }
    {{ sc }} .dg-stat { border-bottom: 1px solid rgba(255,255,255,.16); }
    {{ sc }} .dg-split { grid-template-columns: 1fr; gap: 18px; }
    {{ sc }} .dg-split-img { height: 220px; }
    {{ sc }} .dg-split--flip .dg-split-media { order: 2; }
    {{ sc }} .dg-card-grid { grid-template-columns: 1fr; }
    {{ sc }} .dg-tl-row { grid-template-columns: 1fr; gap: 6px; }
    {{ sc }} .dg-check { grid-template-columns: 1fr; }
    {{ sc }} .dg-quote { padding: 34px 22px; }
    {{ sc }} .dg-quote blockquote { font-size: 21px; }
    {{ sc }} .dg-lead-cap { grid-template-columns: 1fr; padding: 24px; }
    {{ sc }} .dg-form { flex-direction: column; }
    {{ sc }} .dg-shop { padding: 34px 22px; }
  }
  {% render 'section-spacing', sid: section.id, s: section.settings %}
</style>

<script>
  (function () {
    var root = document.getElementById('dg-{{ sid }}');
    if (!root) return;
    root.querySelectorAll('[data-dg-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var t = document.getElementById(btn.getAttribute('data-dg-target'));
        if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>

