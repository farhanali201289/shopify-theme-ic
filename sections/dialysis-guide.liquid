    { "type": "text", "id": "ch3_eyebrow", "label": "Eyebrow", "default": "Chapter 03" },
    { "type": "text", "id": "ch3_heading", "label": "Heading", "default": "A session, hour by hour" },
    { "type": "textarea", "id": "ch3_intro", "label": "Intro", "default": "The first visit is the unknown one. Here is roughly how an in-centre haemodialysis session goes — once you've done it a few times, it becomes routine." },

    { "type": "header", "content": "Chapter 4 — What to wear & pack" },
    { "type": "text", "id": "ch4_eyebrow", "label": "Eyebrow", "default": "Chapter 04" },
    { "type": "text", "id": "ch4_heading", "label": "Heading", "default": "What to wear & pack" },
    { "type": "textarea", "id": "ch4_intro", "label": "Intro", "default": "The right setup is the difference between dreading a session and just getting through it. This is the checklist patients told us they wish they'd had on day one." },
