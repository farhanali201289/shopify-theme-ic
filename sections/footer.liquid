<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'brand' -%}
            <div class="footer__col" {{ block.shopify_attributes }} style="max-width:280px;">
              <div class="footer__brand">{{ block.settings.heading | default: shop.name }}</div>
              {%- if block.settings.text != blank -%}
                <div style="font-size:11.5px; margin-bottom:12px;">{{ block.settings.text }}</div>
              {%- endif -%}
              <div class="footer__social">
                {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}">Instagram</a>{%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}">TikTok</a>{%- endif -%}
                {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}">Facebook</a>{%- endif -%}
                {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}">YouTube</a>{%- endif -%}
              </div>
            </div>

          {%- when 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              {%- assign fmenu = linklists[block.settings.menu] -%}
              {%- for link in fmenu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__col" {{ block.shopify_attributes }} style="max-width:300px;">
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.text != blank -%}
                <div style="font-size:12px; margin-bottom:10px; color:#C9C2B2;">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- form 'customer', class: 'inline-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required aria-label="Email">
                <button type="submit" class="btn btn--accent btn--sm">{{ 'general.newsletter_form.submit' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p style="color:var(--highlight); width:100%; margin-top:8px;">{{ 'general.newsletter_form.confirmation' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      © {{ 'now' | date: '%Y' }} {{ shop.name }} · Designed for treatment, built with care.
      {%- if section.settings.policy_menu != blank -%}
        {%- for link in linklists[section.settings.policy_menu].links -%}
          &nbsp;·&nbsp; <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</footer>

<style>{% render 'section-spacing', sid: section.id, s: section.settings %}</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "policy_menu", "label": "Policy / legal menu" },
    { "type": "header", "content": "─── Spacing & Width ───" },
    { "type": "header", "content": "Padding — Desktop" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_top_unit", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 4 },
    { "type": "select", "id": "padding_bottom_unit", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" },
    { "type": "header", "content": "Padding — Mobile" },
    { "type": "range", "id": "padding_top_mob", "label": "Padding top", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_top_unit_mob", "label": "Padding top unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "padding_bottom_mob", "label": "Padding bottom", "min": 0, "max": 20, "step": 1, "default": 6 },
    { "type": "select", "id": "padding_bottom_unit_mob", "label": "Padding bottom unit", "options": [{"value":"px","label":"px"},{"value":"%","label":"%"}], "default": "%" },
    { "type": "range", "id": "section_width_mob", "label": "Width", "min": 10, "max": 100, "step": 1, "default": 100 },
    { "type": "select", "id": "section_width_unit_mob", "label": "Width unit", "options": [{"value":"%","label":"%"},{"value":"px","label":"px"}], "default": "%" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Brand name" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Learn" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
