  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings use Cormorant Garamond and body uses DM Sans (loaded via Google Fonts to match the brand). Adjust scale below."
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
